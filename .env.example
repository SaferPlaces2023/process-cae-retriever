# CAE Processor Configuration

# ============================================================================
# PROCESSOR MODE CONFIGURATION
# ============================================================================

# CAE_PROCESSOR_MODE: Controls how the processor executes
#   - "local" (default): Run retriever logic locally in the pygeoapi process
#     * Backward compatible with existing setup
#     * No AWS Lambda permissions required
#     * Full processing happens in the processor container
#     * Good for: Development, single-instance deployments, low latency requirements
#
#   - "lambda": Invoke AWS Lambda for processing (new async-capable approach)
#     * Requires CAE_LAMBDA_FUNCTION_NAME to be set
#     * Requires AWS Lambda permissions on the processor execution role
#     * Processor becomes lightweight wrapper for Lambda invocation
#     * Good for: Scalable deployments, separating compute concerns, burst workloads
#
# Default: local
CAE_PROCESSOR_MODE=local

# ============================================================================
# LAMBDA MODE CONFIGURATION
# ============================================================================
# Only required when CAE_PROCESSOR_MODE=lambda

# CAE_LAMBDA_FUNCTION_NAME: AWS Lambda function name
# Example: "process-cae-retriever"
# CAE_LAMBDA_FUNCTION_NAME=process-cae-retriever

# AWS_REGION: AWS region where Lambda function is deployed
# Default: us-east-1
# AWS_REGION=us-east-1

# ============================================================================
# API SECURITY
# ============================================================================

# INT_API_TOKEN: Secret token for process authentication
# This should be a strong, randomly generated string
# INT_API_TOKEN=your_secret_token_here

# ============================================================================
# LOGGING
# ============================================================================

# DEBUG: Enable debug logging
# Default: false
# DEBUG=false

# ============================================================================
# EXAMPLES
# ============================================================================

# Example 1: Local mode (backward compatible)
# CAE_PROCESSOR_MODE=local
# INT_API_TOKEN=your_secret_token
# DEBUG=false

# Example 2: Lambda mode with specific function
# CAE_PROCESSOR_MODE=lambda
# CAE_LAMBDA_FUNCTION_NAME=process-cae-retriever-prod
# AWS_REGION=us-east-1
# INT_API_TOKEN=your_secret_token
# DEBUG=false

# Example 3: Development with local mode and debug logging
# CAE_PROCESSOR_MODE=local
# INT_API_TOKEN=dev_token_123
# DEBUG=true
